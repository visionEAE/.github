<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Google style, trimmed: formatting is Spotless' job (google-java-format); Checkstyle keeps
     the rules a formatter cannot enforce — naming, imports, structure, obvious smells.
     Identical copy in every Java repository of the organisation. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <!-- A Spring Boot entry point is a class with only main(); it is not a utility class. -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="HideUtilityClassConstructor"/>
    <property name="files" value=".*Application\.java$"/>
  </module>

  <module name="FileTabCharacter"/>
  <module name="NewlineAtEndOfFile"/>
  <module name="LineLength">
    <property name="max" value="100"/>
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
  </module>

  <module name="TreeWalker">
    <!-- Naming: classes are nouns in UpperCamelCase, methods and fields in lowerCamelCase,
         no abbreviations shouting in capitals. -->
    <module name="TypeName"/>
    <module name="MethodName">
      <property name="format" value="^[a-z][a-z0-9][a-zA-Z0-9_]*$"/>
    </module>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="ConstantName">
      <!-- Loggers are conventionally lowercase; everything else static final is UPPER_SNAKE. -->
      <property name="format" value="^log(ger)?$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
    </module>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="AbbreviationAsWordInName">
      <property name="allowedAbbreviationLength" value="1"/>
      <property name="ignoreFinal" value="false"/>
    </module>

    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="IllegalImport">
      <!-- Domain code must never depend on these; infrastructure adapters are the only place. -->
      <property name="illegalPkgs" value="sun, com.sun"/>
    </module>

    <!-- Structure and smells -->
    <module name="OneTopLevelClass"/>
    <module name="OuterTypeFilename"/>
    <module name="NeedBraces"/>
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
    </module>
    <module name="EmptyCatchBlock"/>
    <module name="FallThrough"/>
    <module name="MissingSwitchDefault"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="OneStatementPerLine"/>
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>
    <module name="EqualsHashCode"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="java.lang.Throwable, java.lang.Error"/>
    </module>
    <module name="IllegalThrows">
      <!-- Throwable stays allowed: an AspectJ @Around advice has no other choice. -->
      <property name="illegalClassNames" value="Error, RuntimeException, java.lang.Error, java.lang.RuntimeException"/>
    </module>
    <module name="ArrayTypeStyle"/>
    <module name="UpperEll"/>
    <module name="MissingOverride"/>
    <module name="VisibilityModifier">
      <property name="protectedAllowed" value="true"/>
    </module>
    <module name="HideUtilityClassConstructor"/>
    <module name="FinalClass"/>
  </module>
</module>
